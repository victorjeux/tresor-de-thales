                    {
                      "type": "math",
                      "tex": "\\dfrac{AM}{AB} = \\dfrac{AN}{AC} = \\dfrac{MN}{BC}"
                    }
                  ]
                },
                {
                  "title": "Méthode de rédaction",
                  "blocks": [
                    {
                      "type": "text",
                      "text": "Pour utiliser le théorème de Thalès :"
